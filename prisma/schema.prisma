generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────

enum TCG {
  POKEMON
  ONEPIECE
  YUGIOH
  MTG
}

enum Condition {
  NM // Near Mint
  LP // Lightly Played
  MP // Moderately Played
  HP // Heavily Played
  DMG // Damaged
}

enum TradeMode {
  AUTHENTICATED
  DIRECT
}

enum TradeStatus {
  PROPOSED
  ACCEPTED
  ESCROWED
  CARDS_SUBMITTED
  AUTHENTICATING
  VERIFIED
  DELIVERING
  SHIPPING       // direct trades: seller ships to buyer
  DELIVERED
  COMPLETED
  REJECTED
  CANCELLED
  DISPUTED
}

enum TradeLegStatus {
  PENDING
  CARD_RECEIVED
  PHOTO_REVIEW
  AUTHENTICATING
  VERIFIED
  SHIPPED
  DELIVERED
  FAILED
}

enum PhotoApprovalStatus {
  PENDING_PHOTOS
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum GradingCompany {
  PSA
  BGS
  CGC
  SGC
}

enum AuthenticatorTier {
  STANDARD
  VERIFIED
  PREMIUM
}

enum AuthenticatorApplicationStatus {
  DRAFT
  SUBMITTED
  PENDING_REVIEW
  MORE_INFO_NEEDED
  APPROVED
  ONBOARDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  REVOKED
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  WITHDRAWAL_REVERSAL
  TRADE_HOLD
  TRADE_RELEASE
  TRADE_FEE
  TRADE_REFUND
  VERIFICATION_FEE        // debit from user to fund authenticator verification
  VERIFICATION_FEE_REFUND // credit back if trade cancelled after AUTHENTICATING
  AUTHENTICATOR_EARN      // credit to authenticator when trade completes
  DIGITISATION_FEE         // debit from digitiser to fund verification
  DIGITISATION_FEE_REFUND  // credit back if digitisation rejected/cancelled
  DIGITAL_TRADE_HOLD       // buyer funds held during digital trade
  DIGITAL_TRADE_RELEASE    // buyer funds released to seller on completion
  DIGITAL_TRADE_FEE        // platform fee on digital trade
  DIGITISER_ROYALTY         // royalty credit to original digitiser
  REDEMPTION_FEE           // debit from redeemer for redemption handling
  VAULT_EARN               // credit to vault authenticator on redemption
}

// ─── Digitisation Enums ──────────────────────────────────

enum DigitisationStatus {
  SUBMITTED          // User submitted request, card not yet received
  RECEIVED           // Authenticator received physical card
  VERIFYING          // Authenticator inspecting card
  VERIFIED           // Card passed verification
  MINTED             // Digital token created
  REJECTED           // Card failed verification, returned to owner
  CANCELLED          // User cancelled before verification
}

enum DigitalTokenStatus {
  ACTIVE             // Token exists, tradeable
  LISTED             // Token listed for sale on marketplace
  TRADE_LOCKED       // Token locked in an active trade
  REDEMPTION_PENDING // Redemption initiated, awaiting fulfillment
  REDEEMED           // Physical card delivered, token consumed
  BURNED             // Token destroyed (admin action or orphan cleanup)
}

enum RedemptionStatus {
  REQUESTED          // User requested redemption
  STOCK_RESERVED     // Physical card reserved at vault
  PREPARING          // Vault authenticator preparing shipment
  SHIPPED            // Card shipped to redeemer
  DELIVERED          // Card delivered
  COMPLETED          // Confirmed receipt, token burned
  FAILED             // No stock available or delivery failed
  CANCELLED          // User cancelled before shipping
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
  REVERSED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum EscrowEntryType {
  HOLD
  RELEASE
  REFUND
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED_BUYER
  RESOLVED_SELLER
  ESCALATED
  CLOSED
}

enum DeliveryMethod {
  DROP_OFF
  MAIL
}

enum NotificationType {
  TRADE_PROPOSED
  TRADE_ACCEPTED
  TRADE_UPDATE
  MATCH_FOUND
  VERIFICATION_COMPLETE
  DISPUTE_UPDATE
  PHOTO_APPROVAL
  SHIPPING_REMINDER    // authenticator/sender: ship your card
  SHIPPING_SLA_WARNING // authenticator: shipping overdue
  DELIVERY_CONFIRMED   // recipient confirmed receipt
  CARD_RETURN          // trade cancelled, retrieve your card
  DEPOSIT_FAILED       // payment failed during checkout
  ACH_PROCESSING       // ACH deposit submitted, awaiting settlement
  ACH_SETTLED          // ACH deposit settled, funds credited
  ACH_FAILED           // ACH deposit failed after async processing
  CHARGEBACK_ALERT     // Stripe chargeback filed against user
  CHARGEBACK_RESOLVED  // Stripe chargeback resolved
  PAYOUT_COMPLETED     // Express payout reached user's bank
  PAYOUT_FAILED        // Express payout failed at bank level
  WALLET_FROZEN        // wallet frozen due to chargeback/fraud
  TRADE_PAYMENT_FAILED // marketplace escrow payment failed
  TRADE_SETTLED        // marketplace trade settlement completed
  EXPERT_POST_ENDORSED // expert post endorsed by authenticator/admin
  EXPERT_POST_FLAGGED  // expert post flagged for moderation
  SYSTEM
}

// ─── KYC Enums ─────────────────────────────────────────

enum KYCStatus {
  UNVERIFIED
  BASIC_PENDING
  BASIC_VERIFIED
  BASIC_REJECTED
  ENHANCED_PENDING
  ENHANCED_VERIFIED
  ENHANCED_REJECTED
  SUSPENDED
  REVOKED
}

enum KYCDocumentType {
  GOVERNMENT_ID      // passport, driver license, national ID
  SELFIE             // liveness selfie matching ID photo
  PROOF_OF_ADDRESS   // utility bill, bank statement, tax document
  BANK_VERIFICATION  // micro-deposit verification result
}

enum KYCDocumentStatus {
  PENDING   // uploaded, awaiting review
  APPROVED  // verified by reviewer or automated check
  REJECTED  // failed verification
  EXPIRED   // document past expiration date
}

enum MatchOutcomeResult {
  COMPLETED
  CANCELLED
  DISPUTED
}

// ─── Sealed Product Enums ──────────────────────────────────

enum SealedCondition {
  FACTORY_SEALED
  OPENED       // opened but complete contents
  DAMAGED_BOX  // box damage, contents intact
}

enum SealedProductType {
  BOOSTER_BOX
  BOOSTER_PACK
  STARTER_DECK
  BUNDLE
  COLLECTION_BOX
  PREMIUM_PACK
  OTHER
}

// ─── Platform Configuration ─────────────────────────────

model PlatformConfig {
  key         String   @id                // e.g. "platform_fee_rate", "authenticator_fees.STANDARD"
  value       Json                        // any JSON-serializable value
  category    String   @default("general") // grouping: "fees", "thresholds", "matching", "kyc", "shipping"
  description String?                     // human-readable explanation
  version     Int      @default(1)        // increments on each update (optimistic locking)
  updatedBy   String?                     // admin userId who last changed this
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([category])
  @@map("platform_config")
}

model ConfigAudit {
  id        String   @id @default(cuid())
  key       String
  oldValue  Json?
  newValue  Json
  changedBy String
  createdAt DateTime @default(now())

  @@index([key])
  @@index([changedBy])
  @@map("config_audit")
}

// ─── Auth.js Tables ─────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  region        String?
  regionId      String?
  regionRef     Region?   @relation(fields: [regionId], references: [id])
  country       String?
  bio           String?
  stripeCustomerId          String? @unique
  stripeConnectAccountId    String? @unique
  connectOnboardingComplete Boolean @default(false)
  preferredCurrency         String  @default("USD") // ISO-4217 currency code
  walletBalance             Int     @default(0)  // cached balance in USD cents
  walletFrozen              Boolean @default(false)
  walletFrozenReason        String?

  // AI agreement tracking (Phase 3)
  aiAgreementRate           Float?  // fraction of trades where seller's condition matched auth (±1 tier)
  aiAgreementCount          Int     @default(0) // total comparisons with AI grading + authenticator CCS

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  walletTransactions WalletTransaction[]
  pendingDeposits    PendingDeposit[]
  payouts        Payout[]
  tradePayments  TradePayment[]
  tradeTransfers TradeTransfer[]

  haveListings        HaveListing[]
  wantListings        WantListing[]
  gradedHaveListings  GradedHaveListing[]
  gradedWantListings  GradedWantListing[]
  sealedHaveListings  SealedHaveListing[]
  sealedWantListings  SealedWantListing[]
  tradesAsA           Trade[]       @relation("TradeUserA")
  tradesAsB           Trade[]       @relation("TradeUserB")
  notifications       Notification[]

  authenticator Authenticator? @relation("UserAuthenticator")

  // Digitisation
  tokensDigitised        DigitalToken[]         @relation("TokenDigitiser")
  tokensOwned            DigitalToken[]         @relation("TokenOwner")
  digitalTokenListings   DigitalTokenListing[]  @relation("DigitalTokenSeller")
  digitalTradesAsBuyer   DigitalTrade[]         @relation("DigitalTradeBuyer")
  digitalTradesAsSeller  DigitalTrade[]         @relation("DigitalTradeSeller")
  digitisationRequests   DigitisationRequest[]
  redemptions            Redemption[]

  // Shipping
  shippingAddresses  ShippingAddress[]

  // Disputes
  disputes  Dispute[]

  // KYC
  kycStatus          KYCStatus  @default(UNVERIFIED)
  kycVerifiedAt      DateTime?
  kycTierChangedAt   DateTime?
  kycReviewedBy      String?
  kycRejectionReason String?
  kycDocuments       KYCDocument[]
  kycAudits          KYCAudit[]

  // Sanctions
  sanctionsScreenings SanctionsScreening[]

  // Expert Hub
  expertPosts ExpertPost[]

  // Collection
  collectionEntries CollectionEntry[]

  @@index([kycStatus])
  @@index([regionId])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Regions ───────────────────────────────────────────

model Region {
  id          String   @id @default(cuid())
  country     String   // ISO 3166-1 alpha-2 (e.g., "JP", "US", "DE")
  name        String   // Metro area name (e.g., "Tokyo", "Los Angeles")
  customsZone String?  // EU, US, JP, UK, AU, CA — derived from country via CUSTOMS_ZONES
  createdAt   DateTime @default(now())

  authenticators Authenticator[]
  users          User[]

  @@unique([country, name])
  @@index([customsZone])
  @@map("regions")
}

// ─── Shipping Addresses ─────────────────────────────────

model ShippingAddress {
  id         String   @id @default(cuid())
  userId     String
  label      String   // "Home", "Office", "PO Box"
  line1      String
  line2      String?
  city       String
  state      String?  // not all countries have states/provinces
  postalCode String
  country    String   // ISO 3166-1 alpha-2 (JP, US, DE, GB)
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeLegs TradeLeg[] @relation("ShippingAddressLeg")

  @@index([userId])
  @@map("shipping_addresses")
}

// ─── Card Catalog ───────────────────────────────────────

model CardSet {
  id           String    @id @default(cuid())
  tcg          TCG
  code         String    // "OP01", "ST01", "EB01"
  name         String    // "Romance Dawn"
  productType  String?   // "booster" | "starter" | "extra" | "premium" | "promo"
  totalCards   Int?
  cardmarketId     Int?      // Cardmarket expansion ID for re-scraping
  tcgplayerGroupId Int?      // TCGPlayer group ID (via TCGCSV)
  releaseDate      DateTime? // English release date
  createdAt    DateTime  @default(now())

  cards Card[]
  sealedProducts SealedProduct[]
  expertPosts ExpertPost[]

  @@unique([tcg, code])
  @@map("card_sets")
}

model Card {
  id         String   @id @default(cuid())
  tcg        TCG
  name       String
  setName    String
  setCode    String?
  number     String?
  rarity     String?
  imageUrl   String?
  setId      String?
  cardType   String?  // "Character", "Event", "Stage", "Leader", "DON!!"
  effectText String?  // Game mechanics and abilities
  cost       Int?     // Mana or power cost
  power      Int?     // Card power/strength value
  createdAt  DateTime @default(now())

  set                    CardSet?  @relation(fields: [setId], references: [id])
  variants               CardVariant[]
  haveListings           HaveListing[]
  wantListings           WantListing[]
  gradedHaveListings     GradedHaveListing[]
  gradedWantListings     GradedWantListing[]
  authenticatorInventory AuthenticatorInventory[]
  digitalTokens          DigitalToken[]
  digitisationRequests   DigitisationRequest[]
  expertPosts            ExpertPost[]
  collectionEntries      CollectionEntry[]

  @@unique([tcg, setName, number])
  @@index([tcg, name])
  @@map("cards")
}

model CardVariant {
  id             String    @id @default(cuid())
  cardId         String
  language       String    @default("EN")
  edition        String    @default("")  // "1st Edition", "Unlimited", or "" for default
  treatment      String?   // "regular", "alt_art", "manga_rare", "parallel"
  rarity         String?   // Per-variant rarity ("C", "SR", "SEC", etc.)
  version        String    @default("")  // Cardmarket version: "V.1", "V.2", "V.3", or ""
  sourceUrl          String?   // Cardmarket product URL
  imageUrl           String?
  priceEur           Float?    // Latest Cardmarket price in EUR
  priceEurUpdatedAt  DateTime? // When EUR price was last scraped
  priceUpdatedAt     DateTime? // Legacy: kept for backward compat, prefer per-currency fields
  tcgplayerProductId Int?      // TCGPlayer product ID (via TCGCSV)
  tcgplayerUrl       String?   // TCGPlayer product URL
  priceUsd           Float?    // TCGPlayer market price in USD
  priceUsdLow        Float?    // TCGPlayer low price in USD
  priceUsdMid        Float?    // TCGPlayer mid price in USD
  priceUsdHigh       Float?    // TCGPlayer high price in USD
  priceUsdUpdatedAt  DateTime? // When USD prices were last refreshed

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, language, edition, version])
  @@map("card_variants")
}

// ─── Collection ─────────────────────────────────────────

model CollectionEntry {
  id         String     @id @default(cuid())
  userId     String
  cardId     String
  quantity   Int        @default(1)
  condition  Condition?
  acquiredAt DateTime   @default(now())
  pricePaid  Int?       // cents — what the user paid to acquire
  notes      String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId, condition])
  @@index([userId])
  @@index([cardId])
  @@map("collection_entries")
}

// ─── Factory / Production Run Research ──────────────────

enum FactoryConfidence {
  CONFIRMED
  LIKELY
  UNCONFIRMED
}

model PrintingFactory {
  id                 String              @id @default(cuid())
  name               String
  code               String              @unique // slug: "cartamundi-be", "dnp-jp"
  location           String?             // city or region
  country            String              // ISO 3166-1 alpha-2
  operator           String?             // parent company
  tcgsSupported      TCG[]
  languagesSupported String[]            // ISO 639-1: "en", "ja", "de"
  foundedYear        Int?
  websiteUrl         String?
  researchSources    String[]            // URLs confirming this factory
  confidence         FactoryConfidence   @default(UNCONFIRMED)
  qualityNotes       String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  productionRuns ProductionRun[]

  @@unique([name, country])
  @@index([country])
  @@map("printing_factories")
}

model ProductionRun {
  id              String             @id @default(cuid())
  tcg             TCG
  setCode         String
  setName         String
  language        String             // ISO 639-1: "en", "ja", "de"
  factoryId       String
  printingPeriod  String?            // "2023 Q1", "1st Edition Run"
  startDate       DateTime?
  endDate         DateTime?
  edition         String?            // "1st Edition", "Unlimited"
  estimatedVolume Int?
  knownDefects    String[]           // "centering", "color_shift", "miscut"
  researchSources String[]
  researchNotes   String?
  confidence      FactoryConfidence  @default(UNCONFIRMED)
  crowdsourced    Boolean            @default(false)
  reportCount     Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  factory     PrintingFactory @relation(fields: [factoryId], references: [id])
  expertPosts ExpertPost[]

  @@unique([tcg, setCode, language, factoryId, printingPeriod])
  @@index([tcg, setCode, language])
  @@map("production_runs")
}

// ─── Listings ───────────────────────────────────────────

model HaveListing {
  id                       String    @id @default(cuid())
  userId                   String
  cardId                   String
  condition                Condition
  language                 String    @default("EN")
  quantity                 Int       @default(1)
  askPrice                 Int       // minor units in listing currency — minimum value the user wants
  currency                 String    @default("USD") // ISO-4217 currency of askPrice
  usdEquivalent            Int?      // askPrice converted to USD cents at listing time
  exchangeRate             Float?    // rate used: 1 unit local currency = rate USD
  rateTimestamp            DateTime? // when the exchange rate was captured
  notes                    String?
  isActive                 Boolean   @default(true)
  autoAccept               Boolean   @default(false)
  autoAcceptMaxGap         Int?      // max value gap in cents the user will auto-accept
  autoAcceptMaxCycleLength Int?      // max cycle length the user will auto-accept
  autoAcceptRegions        String[]  // regions the user will auto-accept trades from
  isDMM                    Boolean   @default(false) // Created by DMM service, not user

  // AI grading fields (Phase 1)
  aiGradingResult          Json?     // full Ximilar API response for audit
  aiConditionSuggestion    Condition? // AI-suggested condition tier
  aiCCSSurface             Float?    // AI dimension score: surface (1.0-10.0)
  aiCCSCorners             Float?    // AI dimension score: corners (1.0-10.0)
  aiCCSEdges               Float?    // AI dimension score: edges (1.0-10.0)
  aiCCSCentering           Float?    // AI dimension score: centering (1.0-10.0)
  aiCCSComposite           Float?    // AI composite CCS score
  sellerOverrodeAI         Boolean   @default(false)
  overrideReason           String?   // seller's explanation for overriding AI (Phase 3)

  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id])

  tradeLegs            TradeLeg[]            @relation("HaveListingLeg")
  conditionComparisons ConditionComparison[]

  @@index([cardId, condition, isActive])
  @@index([userId])
  @@index([userId, isActive, createdAt])
  @@map("have_listings")
}

model WantListing {
  id                       String     @id @default(cuid())
  userId                   String
  cardId                   String
  minCondition             Condition  @default(LP)
  language                 String?
  maxQuantity              Int        @default(1)
  bidPrice                 Int        // minor units in listing currency — maximum the user will pay
  currency                 String     @default("USD") // ISO-4217 currency of bidPrice
  usdEquivalent            Int?       // bidPrice converted to USD cents at listing time
  exchangeRate             Float?     // rate used: 1 unit local currency = rate USD
  rateTimestamp            DateTime?  // when the exchange rate was captured
  notes                    String?
  isActive                 Boolean    @default(true)
  autoAccept               Boolean    @default(false)
  autoAcceptMaxGap         Int?      // max value gap in cents the user will auto-accept
  autoAcceptMaxCycleLength Int?      // max cycle length the user will auto-accept
  autoAcceptRegions        String[]  // regions the user will auto-accept trades from
  isDMM                    Boolean   @default(false) // Created by DMM service, not user
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card Card @relation(fields: [cardId], references: [id])

  tradeLegs TradeLeg[] @relation("WantListingLeg")

  @@index([cardId, minCondition, isActive])
  @@index([userId])
  @@index([userId, isActive, createdAt])
  @@map("want_listings")
}

// ─── Graded Listings ─────────────────────────────────────

model GradedHaveListing {
  id                       String         @id @default(cuid())
  userId                   String
  cardId                   String
  gradingCompany           GradingCompany
  grade                    Float          // 1.0–10.0
  certNumber               String         @unique // grading company certification ID
  language                 String         @default("EN")
  askPrice                 Int            // minor units in listing currency
  currency                 String         @default("USD") // ISO-4217
  usdEquivalent            Int?           // USD cents at listing time
  exchangeRate             Float?
  rateTimestamp            DateTime?
  notes                    String?
  isActive                 Boolean        @default(true)
  autoAccept               Boolean        @default(false)
  autoAcceptMaxGap         Int?
  autoAcceptMaxCycleLength Int?
  autoAcceptRegions        String[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      Card @relation(fields: [cardId], references: [id])
  tradeLegs TradeLeg[] @relation("GradedHaveListingLeg")

  @@index([cardId, gradingCompany, grade, isActive])
  @@index([userId])
  @@map("graded_have_listings")
}

model GradedWantListing {
  id                       String          @id @default(cuid())
  userId                   String
  cardId                   String
  gradingCompany           GradingCompany? // null = any company
  minGrade                 Float           // minimum acceptable grade
  maxGrade                 Float?          // null = exact minGrade only
  language                 String?
  bidPrice                 Int             // minor units in listing currency
  currency                 String          @default("USD") // ISO-4217
  usdEquivalent            Int?            // USD cents at listing time
  exchangeRate             Float?
  rateTimestamp            DateTime?
  notes                    String?
  isActive                 Boolean         @default(true)
  autoAccept               Boolean         @default(false)
  autoAcceptMaxGap         Int?
  autoAcceptMaxCycleLength Int?
  autoAcceptRegions        String[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  card      Card @relation(fields: [cardId], references: [id])
  tradeLegs TradeLeg[] @relation("GradedWantListingLeg")

  @@index([cardId, isActive])
  @@index([userId])
  @@map("graded_want_listings")
}

// ─── Sealed Products ────────────────────────────────────

model SealedProduct {
  id                 String            @id @default(cuid())
  tcg                TCG
  name               String
  setName            String
  setCode            String?
  productType        SealedProductType
  imageUrl           String?
  language           String            @default("EN")
  tcgplayerProductId Int?              @unique
  tcgplayerUrl       String?
  priceUsd           Float?
  priceUsdLow        Float?
  priceUsdMid        Float?
  priceUpdatedAt     DateTime?
  setId              String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  set                CardSet?               @relation(fields: [setId], references: [id])
  sealedHaveListings SealedHaveListing[]
  sealedWantListings SealedWantListing[]

  @@unique([tcg, name, language])
  @@index([tcg, productType])
  @@map("sealed_products")
}

model SealedHaveListing {
  id                       String          @id @default(cuid())
  userId                   String
  sealedProductId          String
  condition                SealedCondition @default(FACTORY_SEALED)
  language                 String          @default("EN")
  quantity                 Int             @default(1)
  askPrice                 Int             // minor units
  currency                 String          @default("USD")
  usdEquivalent            Int?
  exchangeRate             Float?
  rateTimestamp            DateTime?
  notes                    String?
  isActive                 Boolean         @default(true)
  autoAccept               Boolean         @default(false)
  autoAcceptMaxGap         Int?
  autoAcceptMaxCycleLength Int?
  autoAcceptRegions        String[]
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sealedProduct SealedProduct @relation(fields: [sealedProductId], references: [id])
  tradeLegs     TradeLeg[]    @relation("SealedHaveListingLeg")

  @@index([sealedProductId, condition, isActive])
  @@index([userId])
  @@map("sealed_have_listings")
}

model SealedWantListing {
  id                       String           @id @default(cuid())
  userId                   String
  sealedProductId          String
  minCondition             SealedCondition  @default(FACTORY_SEALED)
  language                 String?          // null = any
  maxQuantity              Int              @default(1)
  bidPrice                 Int              // minor units
  currency                 String           @default("USD")
  usdEquivalent            Int?
  exchangeRate             Float?
  rateTimestamp            DateTime?
  notes                    String?
  isActive                 Boolean          @default(true)
  autoAccept               Boolean          @default(false)
  autoAcceptMaxGap         Int?
  autoAcceptMaxCycleLength Int?
  autoAcceptRegions        String[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  sealedProduct SealedProduct @relation(fields: [sealedProductId], references: [id])
  tradeLegs     TradeLeg[]    @relation("SealedWantListingLeg")

  @@index([sealedProductId, minCondition, isActive])
  @@index([userId])
  @@map("sealed_want_listings")
}

// ─── Matching & Trades ──────────────────────────────────

model MatchProposal {
  id           String    @id @default(cuid())
  score        Float
  cycleLength  Int
  regions      String[]  // regions involved
  tradeMode      TradeMode @default(AUTHENTICATED)
  isViable       Boolean   @default(true)
  isInternational Boolean  @default(false) // true if any leg requires cross-border shipping
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  trade        Trade?
  legs         MatchProposalLeg[]
  matchOutcome MatchOutcome?

  @@map("match_proposals")
}

model MatchProposalLeg {
  id         String @id @default(cuid())
  proposalId String
  fromUserId String
  toUserId   String
  cardId     String
  region     String
  sequence   Int

  haveListingId       String?
  wantListingId       String?
  gradedHaveListingId String?
  gradedWantListingId String?
  sealedHaveListingId String?
  sealedWantListingId String?

  proposal MatchProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@map("match_proposal_legs")
}

model Trade {
  id             String      @id @default(cuid())
  proposalId     String      @unique
  userAId        String
  userBId        String
  participantIds String[]    // all user IDs involved (for multi-party cycles)
  mode           TradeMode   @default(AUTHENTICATED)
  status         TradeStatus @default(PROPOSED)
  statusHistory  Json        @default("[]")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  completedAt    DateTime?

  proposal MatchProposal @relation(fields: [proposalId], references: [id])
  userA    User          @relation("TradeUserA", fields: [userAId], references: [id])
  userB    User          @relation("TradeUserB", fields: [userBId], references: [id])

  legs               TradeLeg[]
  escrow             Escrow?
  disputes           Dispute[]
  walletTransactions WalletTransaction[]
  tradePayments      TradePayment[]
  tradeTransfers     TradeTransfer[]
  matchOutcome       MatchOutcome?

  @@index([userAId, status])
  @@index([userBId, status])
  @@index([status, createdAt])
  @@index([participantIds]) // For multi-party trade lookups. For GIN: CREATE INDEX CONCURRENTLY trades_participant_ids_gin ON trades USING GIN (participant_ids);
  @@map("trades")
}

/// Records match quality data: score at match time + outcome after trade resolves.
/// Enables the scoring feedback loop (Loop 4) — learn which weights produce good trades.
model MatchOutcome {
  id              String              @id @default(cuid())
  proposalId      String              @unique
  tradeId         String?             @unique
  score           Float               // score at match time
  weightsSnapshot Json                // scorer weights snapshot at match time
  outcome         MatchOutcomeResult? // null until trade resolves
  completionDays  Int?                // days from trade creation to completion
  disputeCount    Int                 @default(0)
  cycleLength     Int
  regionCount     Int
  isFullyLocal    Boolean             @default(false)
  isChain         Boolean             @default(false)
  isGraded        Boolean             @default(false)
  isSealed        Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  resolvedAt      DateTime?

  proposal MatchProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  trade    Trade?        @relation(fields: [tradeId], references: [id])

  @@index([outcome])
  @@index([createdAt])
  @@map("match_outcomes")
}

/// Tracks per-user Stripe PaymentIntent for marketplace escrow.
/// Each user who owes money in a trade gets a PaymentIntent (manual capture).
model TradePayment {
  id                   String             @id @default(cuid())
  tradeId              String
  userId               String
  amountCents          Int                // how much this user owes (settlement + fees)
  currency             String             @default("USD")
  stripePaymentIntentId String?           @unique
  stripeChargeId       String?            // populated after capture
  status               TradePaymentStatus @default(PENDING)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  capturedAt           DateTime?
  cancelledAt          DateTime?

  trade Trade @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@unique([tradeId, userId])
  @@index([stripePaymentIntentId])
  @@map("trade_payments")
}

/// Tracks per-user Stripe Transfers for marketplace settlement.
/// Each user who is owed money in a trade gets a Transfer to their Connect account.
model TradeTransfer {
  id                    String              @id @default(cuid())
  tradeId               String
  userId                String              // the recipient (seller)
  amountCents           Int                 // amount transferred to seller
  platformFeeCents      Int                 // platform fee deducted
  currency              String              @default("USD")
  stripeTransferId      String?             @unique
  status                TradeTransferStatus @default(PENDING)
  createdAt             DateTime            @default(now())
  completedAt           DateTime?

  trade Trade? @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id])

  @@index([tradeId])
  @@map("trade_transfers")
}

enum TradePaymentStatus {
  PENDING           // PaymentIntent not yet created
  REQUIRES_ACTION   // PaymentIntent created, awaiting user confirmation
  AUTHORIZED        // PaymentIntent authorized (hold active)
  CAPTURED          // PaymentIntent captured (trade completed)
  CANCELLED         // PaymentIntent cancelled (trade cancelled/refunded)
  FAILED            // PaymentIntent failed
  REFUNDED          // Captured payment refunded (saga rollback)
  VOIDED            // Authorized payment voided during saga rollback
}

enum TradeTransferStatus {
  PENDING    // transfer not yet created
  PAID       // transfer completed
  FAILED     // transfer failed
  REVERSED   // transfer reversed
}

model TradeLeg {
  id                  String         @id @default(cuid())
  tradeId             String
  haveListingId       String?        // set for raw legs
  wantListingId       String?        // set for raw legs
  gradedHaveListingId String?        // set for graded legs
  gradedWantListingId String?        // set for graded legs
  sealedHaveListingId String?        // set for sealed legs
  sealedWantListingId String?        // set for sealed legs
  isGraded            Boolean        @default(false)
  isSealed            Boolean        @default(false)
  fromUserId          String
  toUserId            String
  region              String
  status              TradeLegStatus @default(PENDING)
  authenticatorId     String?
  trackingNumber      String?        // inbound tracking: user → authenticator (mail) or sender → recipient (direct)
  preShipmentPhotos   String[]       // sender evidence photos before shipping
  sequence            Int

  // ─── Shipping fields ─────────────────────────────
  shippingAddressId   String?        // recipient's locked address for this leg
  outboundTracking    String?        // authenticator → recipient tracking (authenticated mode)
  deliveryMethod      DeliveryMethod? // how card reaches authenticator (DROP_OFF or MAIL)
  shippedAt           DateTime?      // when authenticator/sender created shipment
  deliveredAt         DateTime?      // when recipient confirmed delivery
  isInternational     Boolean        @default(false) // true if this leg requires cross-border shipping
  internationalCost   Int?           // quoted international postage cost in cents (user must accept)
  returnTracking      String?        // return tracking if trade cancelled (authenticator → sender)
  receiptPhotos       String[]       // authenticator photos on card receipt
  preShipPhotos       String[]       // authenticator photos before outbound shipping
  deliveryPhotos      String[]       // recipient photos on delivery

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  trade             Trade              @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  haveListing       HaveListing?       @relation("HaveListingLeg", fields: [haveListingId], references: [id])
  wantListing       WantListing?       @relation("WantListingLeg", fields: [wantListingId], references: [id])
  gradedHaveListing GradedHaveListing? @relation("GradedHaveListingLeg", fields: [gradedHaveListingId], references: [id])
  gradedWantListing GradedWantListing? @relation("GradedWantListingLeg", fields: [gradedWantListingId], references: [id])
  sealedHaveListing SealedHaveListing? @relation("SealedHaveListingLeg", fields: [sealedHaveListingId], references: [id])
  sealedWantListing SealedWantListing? @relation("SealedWantListingLeg", fields: [sealedWantListingId], references: [id])

  shippingAddress ShippingAddress? @relation("ShippingAddressLeg", fields: [shippingAddressId], references: [id])
  verification    VerificationAssignment?
  photoApproval   PhotoApproval?

  @@index([tradeId, status])
  @@map("trade_legs")
}

// ─── Photo Approval ─────────────────────────────────────

model PhotoApproval {
  id            String              @id @default(cuid())
  tradeLegId    String              @unique
  status        PhotoApprovalStatus @default(PENDING_PHOTOS)
  photos        String[]
  rejectionNote String?
  attempts      Int                 @default(0)
  submittedAt   DateTime?
  reviewedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  tradeLeg TradeLeg @relation(fields: [tradeLegId], references: [id])

  @@map("photo_approvals")
}

// ─── Authenticator Network ──────────────────────────────

model Authenticator {
  id            String            @id @default(cuid())
  userId        String            @unique
  businessName  String?
  tier          AuthenticatorTier @default(STANDARD)
  region        String
  regionId      String?
  tcgExpertise  TCG[]
  isActive      Boolean           @default(true)
  rating        Float             @default(5.0)
  totalVerified Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Application fields
  applicationStatus AuthenticatorApplicationStatus @default(DRAFT)
  experienceDesc    String?
  proofOfExpertise  String[]       // URLs/references
  appliedAt         DateTime?
  approvedAt        DateTime?

  // Operational fields
  currentLoad       Int            @default(0)  // active assignments
  maxLoad           Int            @default(5)  // concurrent assignment limit
  lastActiveAt      DateTime?
  suspendedAt       DateTime?
  suspensionReason  String?

  // Shipping logistics
  businessAddress      String?     // publicly visible drop-off/mailing address
  shippingNotes        String?     // "Open M-F 10am-6pm", "Mail preferred"
  acceptsDropOff       Boolean     @default(true)
  acceptsMail          Boolean     @default(true)

  // Insurance bond (Phase 3: PREMIUM tier requirement)
  insuranceBondAmount  Int?        // cents — required for PREMIUM tier
  insuranceBondPaidAt  DateTime?

  // Vault operator fields
  vaultCapacity      Int     @default(0)
  isVaultOperator    Boolean @default(false)

  user               User @relation("UserAuthenticator", fields: [userId], references: [id])
  regionRef          Region? @relation(fields: [regionId], references: [id])
  assignments        VerificationAssignment[] @relation("PrimaryAssignments")
  reserveAssignments VerificationAssignment[] @relation("ReserveAssignments")
  inventory          AuthenticatorInventory[]
  dmmDesignation     DMMDesignation?
  audits             AuthenticatorAudit[]
  ratings            AuthenticatorRating[]

  // Digitisation relations
  vaultHoldings          DigitalToken[]         @relation("VaultHolding")
  digitisationRequests   DigitisationRequest[]
  redemptions            Redemption[]           @relation("RedemptionVault")

  @@index([region, isActive])
  @@index([regionId, isActive])
  @@index([applicationStatus])
  @@map("authenticators")
}

model AuthenticatorInventory {
  id              String    @id @default(cuid())
  authenticatorId String
  cardId          String
  condition       Condition
  language        String    @default("EN")
  quantity        Int       @default(1)
  isAvailable     Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authenticator Authenticator @relation(fields: [authenticatorId], references: [id], onDelete: Cascade)
  card          Card          @relation(fields: [cardId], references: [id])

  @@unique([authenticatorId, cardId, condition, language])
  @@index([cardId, isAvailable])
  @@index([authenticatorId])
  @@map("authenticator_inventory")
}

model DMMDesignation {
  id              String    @id @default(cuid())
  authenticatorId String    @unique
  designatedAt    DateTime  @default(now())
  designatedBy    String    // admin userId
  isActive        Boolean   @default(true)
  maxSpreadBps    Int       @default(500)  // max allowed spread in basis points (5%)
  minQuoteCards   Int       @default(10)   // minimum cards they must quote
  obligationMet   Boolean   @default(true) // tracked by cron
  lastCheckAt     DateTime?
  revokedAt       DateTime?
  revokedBy       String?
  revokeReason    String?

  authenticator   Authenticator @relation(fields: [authenticatorId], references: [id])

  @@map("dmm_designations")
}

model VerificationAssignment {
  id              String   @id @default(cuid())
  tradeLegId      String   @unique
  authenticatorId String
  assignedAt      DateTime @default(now())
  completedAt     DateTime?
  result          Json?    // { authentic: boolean, conditionVerified: Condition, notes: string }
  photos          String[]

  // Reserve authenticator failover (Phase 4)
  reserveAuthenticatorId String?
  acceptedAt             DateTime?  // when primary authenticator accepted
  isAudit                Boolean    @default(false)  // Phase 2: random audit flag

  tradeLeg               TradeLeg       @relation(fields: [tradeLegId], references: [id])
  authenticator          Authenticator  @relation("PrimaryAssignments", fields: [authenticatorId], references: [id])
  reserveAuthenticator   Authenticator? @relation("ReserveAssignments", fields: [reserveAuthenticatorId], references: [id])

  @@map("verification_assignments")
}

model AuthenticatorAudit {
  id              String   @id @default(cuid())
  authenticatorId String
  type            String   // PROMOTION, DEMOTION, WARNING, SUSPENSION, APPLICATION_REVIEW
  details         Json
  createdAt       DateTime @default(now())

  authenticator Authenticator @relation(fields: [authenticatorId], references: [id])

  @@index([authenticatorId, type])
  @@map("authenticator_audits")
}

model AuthenticatorRating {
  id              String   @id @default(cuid())
  authenticatorId String
  tradeLegId      String   @unique
  raterId         String   // the card recipient
  score           Float    // 1.0-5.0 overall

  // Component scores (Phase 2: composite rating)
  accuracyScore       Float?  // 1.0-5.0, 40% weight
  speedScore          Float?  // 1.0-5.0, 20% weight
  satisfactionScore   Float?  // 1.0-5.0, 25% weight
  communicationScore  Float?  // 1.0-5.0, 15% weight

  comment         String?
  createdAt       DateTime @default(now())

  authenticator Authenticator @relation(fields: [authenticatorId], references: [id])

  @@index([authenticatorId, createdAt])
  @@map("authenticator_ratings")
}

// ─── Condition Comparison (Phase 4) ─────────────────────

model ConditionComparison {
  id              String @id @default(cuid())
  tradeLegId      String @unique
  haveListingId   String

  // AI CCS dimensions (from HaveListing at listing time)
  aiSurface       Float
  aiCorners       Float
  aiEdges         Float
  aiCentering     Float
  aiComposite     Float

  // Authenticator CCS dimensions (from VerificationAssignment.result)
  authSurface     Float
  authCorners     Float
  authEdges       Float
  authCentering   Float
  authComposite   Float

  // Absolute deltas per dimension
  deltaSurface    Float
  deltaCorners    Float
  deltaEdges      Float
  deltaCentering  Float
  deltaComposite  Float

  // Agreement flag (composite delta ≤ 1.0)
  agreed          Boolean

  // Signed deltas: AI - Auth (positive = AI grades higher)
  signedDeltaSurface   Float?
  signedDeltaCorners   Float?
  signedDeltaEdges     Float?
  signedDeltaCentering Float?
  signedDeltaComposite Float?

  // Denormalized TCG for efficient per-TCG calibration queries
  tcg TCG?

  // Context
  authenticatorId   String
  authenticatorTier AuthenticatorTier
  sellerId          String

  createdAt DateTime @default(now())

  haveListing HaveListing @relation(fields: [haveListingId], references: [id])

  @@index([authenticatorId, agreed])
  @@index([sellerId, agreed])
  @@index([createdAt])
  @@index([tcg, createdAt])
  @@map("condition_comparisons")
}

// ─── Calibration Reports ─────────────────────────────────

model CalibrationReport {
  id              String   @id @default(cuid())
  windowStart     DateTime
  windowEnd       DateTime
  sampleSize      Int
  agreementRate   Float    // fraction within agreement threshold
  confidenceLevel String   // HIGH (>=50), MODERATE (20-49), LOW (<20)

  // Per-dimension signed bias (mean of AI - Auth)
  biasSurface     Float
  biasCorners     Float
  biasEdges       Float
  biasCentering   Float
  biasComposite   Float

  // Per-dimension mean absolute delta
  madSurface      Float
  madCorners      Float
  madEdges        Float
  madCentering    Float
  madComposite    Float

  // Drift detection
  driftDetected     Boolean
  driftDimensions   String[]
  driftDetails      Json?    // per-dimension recent vs baseline comparison

  // Breakdowns
  perTcgBreakdown       Json? // per-TCG metrics
  outlierAuthenticators Json? // flagged authenticators

  // Weight suggestions
  suggestedWeights Json?  // proposed weight adjustments (null if no change needed)
  currentWeights   Json   // snapshot of weights at report time

  // Lifecycle
  status    String    @default("GENERATED") // GENERATED, WEIGHTS_APPLIED, DISMISSED
  appliedAt DateTime?
  appliedBy String?
  createdAt DateTime  @default(now())

  @@index([createdAt])
  @@index([status])
  @@map("calibration_reports")
}

// ─── Wallet ─────────────────────────────────────────────

model WalletTransaction {
  id                    String                @id @default(cuid())
  userId                String
  type                  WalletTransactionType
  amount                Int                   // USD cents: positive = credit, negative = debit
  balanceAfter          Int                   // running balance after this transaction (USD cents)
  description           String
  originalAmount        Int?                  // amount in user's local currency minor units (null = USD)
  originalCurrency      String?               // ISO-4217 of original amount (null = USD)
  exchangeRate          Float?                // rate used for conversion to USD
  tradeId               String?
  stripePaymentIntentId String?  @unique
  stripePayoutId        String?
  createdAt             DateTime              @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  trade  Trade?  @relation(fields: [tradeId], references: [id])
  payout Payout?

  @@index([userId, createdAt])
  @@index([userId, type, createdAt])
  @@index([tradeId])
  @@map("wallet_transactions")
}

// ─── Pending ACH Deposits ─────────────────────────────

model PendingDeposit {
  id                    String               @id @default(cuid())
  userId                String
  amountCents           Int
  stripeSessionId       String               @unique
  stripePaymentIntentId String?              @unique
  status                PendingDepositStatus @default(PROCESSING)
  createdAt             DateTime             @default(now())
  resolvedAt            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("pending_deposits")
}

enum PendingDepositStatus {
  PROCESSING
  SUCCEEDED
  FAILED
}

// ─── Payouts ──────────────────────────────────────────

model Payout {
  id                  String       @id @default(cuid())
  userId              String
  walletTransactionId String       @unique
  stripeTransferId    String?      @unique
  stripePayoutId      String?
  amount              Int          // cents
  status              PayoutStatus @default(PENDING)
  failureReason       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  paidAt              DateTime?
  failedAt            DateTime?

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletTransaction WalletTransaction @relation(fields: [walletTransactionId], references: [id])

  @@index([userId, status])
  @@index([stripeTransferId])
  @@map("payouts")
}

// ─── Escrow ─────────────────────────────────────────────

model Escrow {
  id          String       @id @default(cuid())
  tradeId     String       @unique
  status      EscrowStatus @default(HELD)
  totalAmount Int          // in cents
  currency    String       @default("USD")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  trade   Trade         @relation(fields: [tradeId], references: [id])
  entries EscrowEntry[]

  @@map("escrows")
}

model EscrowEntry {
  id        String          @id @default(cuid())
  escrowId  String
  type      EscrowEntryType
  amount    Int             // in cents
  note      String?
  createdAt DateTime        @default(now())

  escrow Escrow @relation(fields: [escrowId], references: [id], onDelete: Cascade)

  @@map("escrow_entries")
}

// ─── Disputes ───────────────────────────────────────────

model Dispute {
  id          String        @id @default(cuid())
  tradeId     String
  tradeLegId  String?       // optional: per-leg shipping disputes
  raisedById  String
  reason      String        // free text or structured: NOT_RECEIVED, DAMAGED_IN_TRANSIT, WRONG_CARD, EMPTY_PACKAGE, CONDITION_MISMATCH
  evidence    String[]
  status      DisputeStatus @default(OPEN)
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  trade    Trade @relation(fields: [tradeId], references: [id])
  raisedBy User  @relation(fields: [raisedById], references: [id])

  @@index([tradeId])
  @@map("disputes")
}

// ─── Notifications ──────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── KYC ───────────────────────────────────────────────

model KYCDocument {
  id              String            @id @default(cuid())
  userId          String
  type            KYCDocumentType
  status          KYCDocumentStatus @default(PENDING)

  // Document metadata (NOT raw file content)
  fileName        String
  mimeType        String            // image/jpeg, image/png, application/pdf
  storageKey      String            // S3 key: "kyc/{userId}/{docId}/{fileName}"

  // Verification
  verifiedAt      DateTime?
  verifiedBy      String?           // admin userId (null for automatic)
  rejectedAt      DateTime?
  rejectionReason String?

  // Expiration tracking (for IDs with expiry dates)
  documentExpiry  DateTime?
  isExpired       Boolean           @default(false)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, status])
  @@index([status])
  @@map("kyc_documents")
}

model KYCAudit {
  id         String    @id @default(cuid())
  userId     String
  action     String    // SUBMIT_BASIC, SUBMIT_ENHANCED, APPROVE, REJECT, SUSPEND, REVOKE, REINSTATE
  fromStatus KYCStatus
  toStatus   KYCStatus
  reason     String?
  reviewedBy String?   // admin userId (null for user-initiated actions)
  details    Json?     // additional context (document IDs, rejection details, etc.)
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("kyc_audits")
}

// ─── Digitisation ────────────────────────────────────────

model DigitisationRequest {
  id                String             @id @default(cuid())
  userId            String
  cardId            String
  condition         Condition
  language          String             @default("EN")
  authenticatorId   String
  status            DigitisationStatus @default(SUBMITTED)

  // Verification outcome
  verifiedCondition Condition?
  ccsResult         Json?
  rejectionReason   String?

  // Tracking
  trackingInbound   String?
  receivedAt        DateTime?
  verifiedAt        DateTime?
  mintedAt          DateTime?

  // Fee
  verificationFeeCents Int

  // Result
  tokenId           String?  @unique

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  card          Card          @relation(fields: [cardId], references: [id])
  authenticator Authenticator @relation(fields: [authenticatorId], references: [id])
  token         DigitalToken? @relation(fields: [tokenId], references: [id])

  @@index([userId, status])
  @@index([authenticatorId, status])
  @@map("digitisation_requests")
}

// ─── Digital Token ───────────────────────────────────────

model DigitalToken {
  id              String             @id @default(cuid())
  cardId          String
  condition       Condition
  language        String             @default("EN")

  // Ownership
  digitiserId     String
  currentOwnerId  String

  // Status
  status          DigitalTokenStatus @default(ACTIVE)

  // Vault tracking
  vaultAuthenticatorId String

  // Timestamps
  mintedAt        DateTime
  lastTradedAt    DateTime?
  redeemedAt      DateTime?

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  card            Card               @relation(fields: [cardId], references: [id])
  digitiser       User               @relation("TokenDigitiser", fields: [digitiserId], references: [id])
  currentOwner    User               @relation("TokenOwner", fields: [currentOwnerId], references: [id])
  vaultAuthenticator Authenticator   @relation("VaultHolding", fields: [vaultAuthenticatorId], references: [id])

  digitisationRequest DigitisationRequest?
  transfers       DigitalTokenTransfer[]
  listings        DigitalTokenListing[]
  redemption      Redemption?

  @@index([cardId, condition, status])
  @@index([currentOwnerId, status])
  @@index([digitiserId])
  @@index([vaultAuthenticatorId])
  @@map("digital_tokens")
}

// ─── Transfer Log (Audit Trail) ──────────────────────────

model DigitalTokenTransfer {
  id           String   @id @default(cuid())
  tokenId      String
  fromUserId   String
  toUserId     String
  priceCents   Int
  royaltyCents Int
  platformFeeCents Int
  tradeId      String?
  transferredAt DateTime @default(now())

  token DigitalToken @relation(fields: [tokenId], references: [id])

  @@index([tokenId, transferredAt])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("digital_token_transfers")
}

// ─── Digital Token Marketplace ───────────────────────────

model DigitalTokenListing {
  id          String   @id @default(cuid())
  tokenId     String
  sellerId    String
  askPrice    Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  token  DigitalToken @relation(fields: [tokenId], references: [id])
  seller User         @relation("DigitalTokenSeller", fields: [sellerId], references: [id])
  trade  DigitalTrade?

  @@index([tokenId, isActive])
  @@index([sellerId, isActive])
  @@map("digital_token_listings")
}

// ─── Digital Trade ───────────────────────────────────────

model DigitalTrade {
  id           String   @id @default(cuid())
  listingId    String   @unique
  buyerId      String
  sellerId     String
  tokenId      String
  priceCents   Int
  platformFeeCents Int
  royaltyCents Int
  sellerNetCents Int

  completedAt  DateTime?
  createdAt    DateTime @default(now())

  listing DigitalTokenListing @relation(fields: [listingId], references: [id])
  buyer   User                @relation("DigitalTradeBuyer", fields: [buyerId], references: [id])
  seller  User                @relation("DigitalTradeSeller", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@map("digital_trades")
}

// ─── Redemption ──────────────────────────────────────────

model Redemption {
  id                   String           @id @default(cuid())
  tokenId              String           @unique
  redeemerId           String

  // Which vault fulfills
  vaultAuthenticatorId String
  vaultCountry         String
  redeemerCountry      String
  isCrossZone          Boolean          @default(false)

  status               RedemptionStatus @default(REQUESTED)

  // Fulfillment tracking
  trackingOutbound     String?

  // Fees
  redemptionFeeCents   Int
  crossZoneSurcharge   Int              @default(0)

  shippedAt            DateTime?
  deliveredAt          DateTime?
  completedAt          DateTime?
  failureReason        String?

  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  token             DigitalToken  @relation(fields: [tokenId], references: [id])
  redeemer          User          @relation(fields: [redeemerId], references: [id])
  vaultAuthenticator Authenticator @relation("RedemptionVault", fields: [vaultAuthenticatorId], references: [id])

  @@index([redeemerId, status])
  @@index([vaultAuthenticatorId, status])
  @@map("redemptions")
}

// ─── Exchange Rate Cache ─────────────────────────────

model ExchangeRateCache {
  id            String   @id @default(cuid())
  baseCurrency  String   @default("USD")     // rates are relative to this
  rates         Json                         // { "EUR": 0.921, "JPY": 148.5, ... }
  source        String   @default("wise")    // "wise" | "openexchangerates" | "ecb"
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime                     // fetchedAt + TTL

  @@index([baseCurrency, fetchedAt])
  @@map("exchange_rate_cache")
}

// ─── Stripe Webhook Dedup ───────────────────────────

model ProcessedStripeEvent {
  id          String   @id // Stripe event ID (evt_...)
  type        String   // event type for debugging
  processedAt DateTime @default(now())

  @@map("processed_stripe_events")
}

// ─── Sanctions Screening ──────────────────────────────────────

enum SanctionsScreeningStatus {
  CLEAR
  PENDING_REVIEW
  FLAGGED
  DENIED
}

model SanctionsScreening {
  id               String                    @id @default(cuid())
  userId           String
  status           SanctionsScreeningStatus  @default(CLEAR)
  screenedName     String                    // name that was screened
  matchName        String?                   // SDN entry that matched (if any)
  matchScore       Float?                    // similarity score 0-1
  matchProgram     String?                   // OFAC program (e.g. "SDGT", "IRAN")
  source           String                    @default("OFAC_SDN") // screening source
  reviewedBy       String?                   // admin user ID
  reviewNotes      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("sanctions_screenings")
}

// ─── Expert Knowledge Hub ────────────────────────────

enum ExpertPostCategory {
  PRICE_ANALYSIS
  COMBO_GUIDE
  SET_REVIEW
  CONDITION_GUIDE
  META_ANALYSIS
  FACTORY_DEFECT
  GRADING_TIPS
  STORAGE_TIPS
  INVESTMENT_OUTLOOK
  MARKET_TRENDS
}

enum ExpertPostStatus {
  DRAFT
  PENDING
  PUBLISHED
  FLAGGED
  REMOVED
}

model ExpertPost {
  id          String              @id @default(cuid())
  authorId    String
  category    ExpertPostCategory
  title       String              // max 200 chars, enforced by validator
  content     String              @db.Text // Markdown content
  excerpt     String?             // auto-generated from first 200 chars of content

  // Catalog anchors (at least one required, enforced by service)
  cardId      String?
  setId       String?
  tcg         TCG?

  // Language — null = cross-language
  language    String?

  // Metadata
  tags        String[]            @default([])
  mediaUrls   String[]            @default([])

  // Trust / moderation
  status      ExpertPostStatus    @default(DRAFT)
  upvotes     Int                 @default(0)
  downvotes   Int                 @default(0)
  helpfulCount Int                @default(0)
  reportCount  Int                @default(0)
  moderatedBy  String?
  moderatedAt  DateTime?
  moderationNote String?

  // Timestamps
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  publishedAt DateTime?

  // Factory link (Loop 5: Expert→Catalog enrichment)
  productionRunId String?

  // Relations
  author        User               @relation(fields: [authorId], references: [id])
  card          Card?              @relation(fields: [cardId], references: [id])
  set           CardSet?           @relation(fields: [setId], references: [id])
  productionRun ProductionRun?     @relation(fields: [productionRunId], references: [id])
  votes         ExpertVote[]
  endorsements  ExpertEndorsement[]

  @@index([tcg, status, publishedAt])
  @@index([cardId, status])
  @@index([setId, status])
  @@index([authorId, status])
  @@index([productionRunId])
  @@map("expert_posts")
}

model ExpertVote {
  id       String   @id @default(cuid())
  postId   String
  userId   String
  value    Int      // +1 upvote, -1 downvote
  helpful  Boolean  @default(false) // separate "this was helpful" flag

  createdAt DateTime @default(now())

  post ExpertPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("expert_votes")
}

model ExpertEndorsement {
  id           String   @id @default(cuid())
  postId       String
  endorserId   String
  endorserType String   // "authenticator" | "admin"
  note         String?

  createdAt DateTime @default(now())

  post ExpertPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, endorserId])
  @@map("expert_endorsements")
}
